PORT=3000
# Obtenha uma chave no console Groq e mantenha-a somente no ambiente do servidor.
GROQ_API_KEY=
# Opcional; o valor padrão é llama-3.3-70b-versatile
GROQ_MODEL=llama-3.3-70b-versatile
# Configure um usuário para a área administrativa. Valor sugerido: davi
ADMIN_USERNAME=davi
# Defina no painel seguro do host uma senha forte, longa e exclusiva; não use senha publicada em chats.
ADMIN_PASSWORD=
# Segredo aleatório longo para assinar sessões; nunca compartilhe ou versione o valor real.
ADMIN_SESSION_SECRET=
# O repositório DV Odonto atual é privado; substitua pela URL pública do app se houver.
DV_ODONTO_URL=https://github.com/davicarmomacarau-ux/DV-Odonto
# Ative somente se o app estiver atrás de um proxy reverso confiável.
TRUST_PROXY=false
