PORT=3000
# Obtenha uma chave no console Groq e mantenha-a somente no ambiente do servidor.
GROQ_API_KEY=
# Opcional; o valor padrão é llama-3.3-70b-versatile
GROQ_MODEL=llama-3.3-70b-versatile
# O repositório DV Odonto atual é privado; substitua pela URL pública do app se houver.
DV_ODONTO_URL=https://github.com/davicarmomacarau-ux/DV-Odonto
# Origens separadas por vírgula; vazio permite origem same-site ou todas para esta API pública.
ALLOWED_ORIGINS=
